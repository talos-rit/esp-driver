menu "Talos ESP Driver Configuration"
    config DRIVER_MOTORHAT_SDA_PIN
        int "MotorHAT SDA Pin"
        default 21
        help
            GPIO pin number for MotorHAT SDA line.

    config DRIVER_MOTORHAT_SCL_PIN
        int "MotorHAT SCL Pin"
        default 22
        help
            GPIO pin number for MotorHAT SCL line.

    config DRIVER_MOTORHAT_I2C_BUS
        int "MotorHAT I2C Bus Number"
        default 1
        help
            I2C bus number for MotorHAT communication.

    config DRIVER_MOTORHAT_ADDRESS
        hex "MotorHAT I2C Address"
        default 0x60
        help
            I2C address for the first MotorHAT (motor ports 1-4).

    config DRIVER_MOTORHAT2_ENABLE
        bool "Second MotorHAT (motor ports 5-8)"
        default y
        help
            A second HAT on the same I2C bus. Motors in the Motors menu can
            then be placed on HAT 2. Boot fails if it does not answer at
            DRIVER_MOTORHAT2_ADDRESS. Every stop (emergency, pan stop,
            homing) covers both HATs.

    config DRIVER_MOTORHAT2_ADDRESS
        hex "Second MotorHAT I2C Address"
        depends on DRIVER_MOTORHAT2_ENABLE
        range 0x60 0x7F
        default 0x61
        help
            Set by the A0-A4 solder jumpers on the second HAT: 0x61 is A0
            bridged. Must differ from the first HAT. Do not use 0x70, every
            PCA9685 answers that address at power on.

    config DRIVER_MOTORHAT_PAN_SPEED
        string "MotorHAT homing speed"
        default "0.25"
        help
            The fraction of PCA9685's max PWM speed used by homing. Polar pan
            uses the per-axis speeds in the Axes menu.

    config DRIVER_CURRENT_SENSING_ENABLE
        bool "Enable ADS1015 overcurrent stop"
        default n
        help
            When on, every enabled ADC below is started and all motors stop
            if any shunt reading passes the threshold (ADS1015 Configuration
            menu). Boot fails if an enabled ADC does not answer.
            When off, the ADCs are never touched; motion is bounded only by
            soft limits and the max run time.
            The pair-to-motor defaults below follow the planned wiring and
            have not been checked on the robot yet.

    config DRIVER_ADC1_ENABLE
        bool "ADC 1 (ADS1015)"
        depends on DRIVER_CURRENT_SENSING_ENABLE
        default y
        help
            On shunt board 1. Defaults: A0-A1 = Axis 1, A2-A3 = Axis 2.

    config DRIVER_ADC1_ADDRESS
        hex "ADC 1 I2C address"
        depends on DRIVER_ADC1_ENABLE
        range 0x48 0x4B
        default 0x48
        help
            Set by the ADS1015 ADDR pin: GND = 0x48, VDD = 0x49, SDA = 0x4A,
            SCL = 0x4B. Every ADC needs a different one.

    config DRIVER_ADC1_RDY_PIN
        int "ADC 1 RDY (ALERT) GPIO"
        depends on DRIVER_ADC1_ENABLE
        range 0 39
        default 18
        help
            Every ADC needs its own RDY pin. Avoid GPIO 0, 2 and 12 (boot
            strapping) and the I2C, encoder and limit switch pins.

    choice DRIVER_ADC1_PAIR_A_MOTOR_SEL
        prompt "ADC 1 A0-A1 measures"
        depends on DRIVER_ADC1_ENABLE
        default DRIVER_ADC1_PAIR_A_MOTOR_AXIS1
        help
            The motor whose shunt this pair reads. Any overcurrent stops every
            motor; this only names the motor and its overcurrent bit.
        config DRIVER_ADC1_PAIR_A_MOTOR_NONE
            bool "None"
        config DRIVER_ADC1_PAIR_A_MOTOR_AXIS1
            bool "Axis 1 (base)"
        config DRIVER_ADC1_PAIR_A_MOTOR_AXIS2
            bool "Axis 2 (shoulder)"
        config DRIVER_ADC1_PAIR_A_MOTOR_AXIS3
            bool "Axis 3 (elbow)"
        config DRIVER_ADC1_PAIR_A_MOTOR_AXIS4
            bool "Axis 4 (wrist motor 4)"
        config DRIVER_ADC1_PAIR_A_MOTOR_AXIS5
            bool "Axis 5 (wrist motor 5)"
        config DRIVER_ADC1_PAIR_A_MOTOR_GRIPPER
            bool "Gripper"
    endchoice

    config DRIVER_ADC1_PAIR_A_MOTOR_ID
        int
        depends on DRIVER_ADC1_ENABLE
        default 0 if DRIVER_ADC1_PAIR_A_MOTOR_NONE
        default 1 if DRIVER_ADC1_PAIR_A_MOTOR_AXIS1
        default 2 if DRIVER_ADC1_PAIR_A_MOTOR_AXIS2
        default 3 if DRIVER_ADC1_PAIR_A_MOTOR_AXIS3
        default 4 if DRIVER_ADC1_PAIR_A_MOTOR_AXIS4
        default 5 if DRIVER_ADC1_PAIR_A_MOTOR_AXIS5
        default 6 if DRIVER_ADC1_PAIR_A_MOTOR_GRIPPER

    choice DRIVER_ADC1_PAIR_B_MOTOR_SEL
        prompt "ADC 1 A2-A3 measures"
        depends on DRIVER_ADC1_ENABLE
        default DRIVER_ADC1_PAIR_B_MOTOR_AXIS2
        help
            The motor whose shunt this pair reads. Any overcurrent stops every
            motor; this only names the motor and its overcurrent bit.
        config DRIVER_ADC1_PAIR_B_MOTOR_NONE
            bool "None"
        config DRIVER_ADC1_PAIR_B_MOTOR_AXIS1
            bool "Axis 1 (base)"
        config DRIVER_ADC1_PAIR_B_MOTOR_AXIS2
            bool "Axis 2 (shoulder)"
        config DRIVER_ADC1_PAIR_B_MOTOR_AXIS3
            bool "Axis 3 (elbow)"
        config DRIVER_ADC1_PAIR_B_MOTOR_AXIS4
            bool "Axis 4 (wrist motor 4)"
        config DRIVER_ADC1_PAIR_B_MOTOR_AXIS5
            bool "Axis 5 (wrist motor 5)"
        config DRIVER_ADC1_PAIR_B_MOTOR_GRIPPER
            bool "Gripper"
    endchoice

    config DRIVER_ADC1_PAIR_B_MOTOR_ID
        int
        depends on DRIVER_ADC1_ENABLE
        default 0 if DRIVER_ADC1_PAIR_B_MOTOR_NONE
        default 1 if DRIVER_ADC1_PAIR_B_MOTOR_AXIS1
        default 2 if DRIVER_ADC1_PAIR_B_MOTOR_AXIS2
        default 3 if DRIVER_ADC1_PAIR_B_MOTOR_AXIS3
        default 4 if DRIVER_ADC1_PAIR_B_MOTOR_AXIS4
        default 5 if DRIVER_ADC1_PAIR_B_MOTOR_AXIS5
        default 6 if DRIVER_ADC1_PAIR_B_MOTOR_GRIPPER

    config DRIVER_ADC2_ENABLE
        bool "ADC 2 (ADS1015)"
        depends on DRIVER_CURRENT_SENSING_ENABLE
        default y
        help
            On shunt board 1. Defaults: A0-A1 = Axis 3, A2-A3 = Axis 4.

    config DRIVER_ADC2_ADDRESS
        hex "ADC 2 I2C address"
        depends on DRIVER_ADC2_ENABLE
        range 0x48 0x4B
        default 0x49
        help
            Set by the ADS1015 ADDR pin: GND = 0x48, VDD = 0x49, SDA = 0x4A,
            SCL = 0x4B. Every ADC needs a different one.

    config DRIVER_ADC2_RDY_PIN
        int "ADC 2 RDY (ALERT) GPIO"
        depends on DRIVER_ADC2_ENABLE
        range 0 39
        default 19
        help
            Every ADC needs its own RDY pin. Avoid GPIO 0, 2 and 12 (boot
            strapping) and the I2C, encoder and limit switch pins.

    choice DRIVER_ADC2_PAIR_A_MOTOR_SEL
        prompt "ADC 2 A0-A1 measures"
        depends on DRIVER_ADC2_ENABLE
        default DRIVER_ADC2_PAIR_A_MOTOR_AXIS3
        help
            The motor whose shunt this pair reads. Any overcurrent stops every
            motor; this only names the motor and its overcurrent bit.
        config DRIVER_ADC2_PAIR_A_MOTOR_NONE
            bool "None"
        config DRIVER_ADC2_PAIR_A_MOTOR_AXIS1
            bool "Axis 1 (base)"
        config DRIVER_ADC2_PAIR_A_MOTOR_AXIS2
            bool "Axis 2 (shoulder)"
        config DRIVER_ADC2_PAIR_A_MOTOR_AXIS3
            bool "Axis 3 (elbow)"
        config DRIVER_ADC2_PAIR_A_MOTOR_AXIS4
            bool "Axis 4 (wrist motor 4)"
        config DRIVER_ADC2_PAIR_A_MOTOR_AXIS5
            bool "Axis 5 (wrist motor 5)"
        config DRIVER_ADC2_PAIR_A_MOTOR_GRIPPER
            bool "Gripper"
    endchoice

    config DRIVER_ADC2_PAIR_A_MOTOR_ID
        int
        depends on DRIVER_ADC2_ENABLE
        default 0 if DRIVER_ADC2_PAIR_A_MOTOR_NONE
        default 1 if DRIVER_ADC2_PAIR_A_MOTOR_AXIS1
        default 2 if DRIVER_ADC2_PAIR_A_MOTOR_AXIS2
        default 3 if DRIVER_ADC2_PAIR_A_MOTOR_AXIS3
        default 4 if DRIVER_ADC2_PAIR_A_MOTOR_AXIS4
        default 5 if DRIVER_ADC2_PAIR_A_MOTOR_AXIS5
        default 6 if DRIVER_ADC2_PAIR_A_MOTOR_GRIPPER

    choice DRIVER_ADC2_PAIR_B_MOTOR_SEL
        prompt "ADC 2 A2-A3 measures"
        depends on DRIVER_ADC2_ENABLE
        default DRIVER_ADC2_PAIR_B_MOTOR_AXIS4
        help
            The motor whose shunt this pair reads. Any overcurrent stops every
            motor; this only names the motor and its overcurrent bit.
        config DRIVER_ADC2_PAIR_B_MOTOR_NONE
            bool "None"
        config DRIVER_ADC2_PAIR_B_MOTOR_AXIS1
            bool "Axis 1 (base)"
        config DRIVER_ADC2_PAIR_B_MOTOR_AXIS2
            bool "Axis 2 (shoulder)"
        config DRIVER_ADC2_PAIR_B_MOTOR_AXIS3
            bool "Axis 3 (elbow)"
        config DRIVER_ADC2_PAIR_B_MOTOR_AXIS4
            bool "Axis 4 (wrist motor 4)"
        config DRIVER_ADC2_PAIR_B_MOTOR_AXIS5
            bool "Axis 5 (wrist motor 5)"
        config DRIVER_ADC2_PAIR_B_MOTOR_GRIPPER
            bool "Gripper"
    endchoice

    config DRIVER_ADC2_PAIR_B_MOTOR_ID
        int
        depends on DRIVER_ADC2_ENABLE
        default 0 if DRIVER_ADC2_PAIR_B_MOTOR_NONE
        default 1 if DRIVER_ADC2_PAIR_B_MOTOR_AXIS1
        default 2 if DRIVER_ADC2_PAIR_B_MOTOR_AXIS2
        default 3 if DRIVER_ADC2_PAIR_B_MOTOR_AXIS3
        default 4 if DRIVER_ADC2_PAIR_B_MOTOR_AXIS4
        default 5 if DRIVER_ADC2_PAIR_B_MOTOR_AXIS5
        default 6 if DRIVER_ADC2_PAIR_B_MOTOR_GRIPPER

    config DRIVER_ADC3_ENABLE
        bool "ADC 3 (ADS1015)"
        depends on DRIVER_CURRENT_SENSING_ENABLE
        default y
        help
            On shunt board 2. Defaults: A0-A1 = Axis 5, A2-A3 = Gripper.

    config DRIVER_ADC3_ADDRESS
        hex "ADC 3 I2C address"
        depends on DRIVER_ADC3_ENABLE
        range 0x48 0x4B
        default 0x4A
        help
            Set by the ADS1015 ADDR pin: GND = 0x48, VDD = 0x49, SDA = 0x4A,
            SCL = 0x4B. Every ADC needs a different one.

    config DRIVER_ADC3_RDY_PIN
        int "ADC 3 RDY (ALERT) GPIO"
        depends on DRIVER_ADC3_ENABLE
        range 0 39
        default 5
        help
            Every ADC needs its own RDY pin. Avoid GPIO 0, 2 and 12 (boot
            strapping) and the I2C, encoder and limit switch pins.

    choice DRIVER_ADC3_PAIR_A_MOTOR_SEL
        prompt "ADC 3 A0-A1 measures"
        depends on DRIVER_ADC3_ENABLE
        default DRIVER_ADC3_PAIR_A_MOTOR_AXIS5
        help
            The motor whose shunt this pair reads. Any overcurrent stops every
            motor; this only names the motor and its overcurrent bit.
        config DRIVER_ADC3_PAIR_A_MOTOR_NONE
            bool "None"
        config DRIVER_ADC3_PAIR_A_MOTOR_AXIS1
            bool "Axis 1 (base)"
        config DRIVER_ADC3_PAIR_A_MOTOR_AXIS2
            bool "Axis 2 (shoulder)"
        config DRIVER_ADC3_PAIR_A_MOTOR_AXIS3
            bool "Axis 3 (elbow)"
        config DRIVER_ADC3_PAIR_A_MOTOR_AXIS4
            bool "Axis 4 (wrist motor 4)"
        config DRIVER_ADC3_PAIR_A_MOTOR_AXIS5
            bool "Axis 5 (wrist motor 5)"
        config DRIVER_ADC3_PAIR_A_MOTOR_GRIPPER
            bool "Gripper"
    endchoice

    config DRIVER_ADC3_PAIR_A_MOTOR_ID
        int
        depends on DRIVER_ADC3_ENABLE
        default 0 if DRIVER_ADC3_PAIR_A_MOTOR_NONE
        default 1 if DRIVER_ADC3_PAIR_A_MOTOR_AXIS1
        default 2 if DRIVER_ADC3_PAIR_A_MOTOR_AXIS2
        default 3 if DRIVER_ADC3_PAIR_A_MOTOR_AXIS3
        default 4 if DRIVER_ADC3_PAIR_A_MOTOR_AXIS4
        default 5 if DRIVER_ADC3_PAIR_A_MOTOR_AXIS5
        default 6 if DRIVER_ADC3_PAIR_A_MOTOR_GRIPPER

    choice DRIVER_ADC3_PAIR_B_MOTOR_SEL
        prompt "ADC 3 A2-A3 measures"
        depends on DRIVER_ADC3_ENABLE
        default DRIVER_ADC3_PAIR_B_MOTOR_GRIPPER
        help
            The motor whose shunt this pair reads. Any overcurrent stops every
            motor; this only names the motor and its overcurrent bit.
        config DRIVER_ADC3_PAIR_B_MOTOR_NONE
            bool "None"
        config DRIVER_ADC3_PAIR_B_MOTOR_AXIS1
            bool "Axis 1 (base)"
        config DRIVER_ADC3_PAIR_B_MOTOR_AXIS2
            bool "Axis 2 (shoulder)"
        config DRIVER_ADC3_PAIR_B_MOTOR_AXIS3
            bool "Axis 3 (elbow)"
        config DRIVER_ADC3_PAIR_B_MOTOR_AXIS4
            bool "Axis 4 (wrist motor 4)"
        config DRIVER_ADC3_PAIR_B_MOTOR_AXIS5
            bool "Axis 5 (wrist motor 5)"
        config DRIVER_ADC3_PAIR_B_MOTOR_GRIPPER
            bool "Gripper"
    endchoice

    config DRIVER_ADC3_PAIR_B_MOTOR_ID
        int
        depends on DRIVER_ADC3_ENABLE
        default 0 if DRIVER_ADC3_PAIR_B_MOTOR_NONE
        default 1 if DRIVER_ADC3_PAIR_B_MOTOR_AXIS1
        default 2 if DRIVER_ADC3_PAIR_B_MOTOR_AXIS2
        default 3 if DRIVER_ADC3_PAIR_B_MOTOR_AXIS3
        default 4 if DRIVER_ADC3_PAIR_B_MOTOR_AXIS4
        default 5 if DRIVER_ADC3_PAIR_B_MOTOR_AXIS5
        default 6 if DRIVER_ADC3_PAIR_B_MOTOR_GRIPPER

    config DRIVER_ADC4_ENABLE
        bool "ADC 4 (ADS1015)"
        depends on DRIVER_CURRENT_SENSING_ENABLE
        default n
        help
            Future fourth ADC. Both pairs default to None.

    config DRIVER_ADC4_ADDRESS
        hex "ADC 4 I2C address"
        depends on DRIVER_ADC4_ENABLE
        range 0x48 0x4B
        default 0x4B
        help
            Set by the ADS1015 ADDR pin: GND = 0x48, VDD = 0x49, SDA = 0x4A,
            SCL = 0x4B. Every ADC needs a different one.

    config DRIVER_ADC4_RDY_PIN
        int "ADC 4 RDY (ALERT) GPIO"
        depends on DRIVER_ADC4_ENABLE
        range 0 39
        default 15
        help
            Every ADC needs its own RDY pin. Avoid GPIO 0, 2 and 12 (boot
            strapping) and the I2C, encoder and limit switch pins.

    choice DRIVER_ADC4_PAIR_A_MOTOR_SEL
        prompt "ADC 4 A0-A1 measures"
        depends on DRIVER_ADC4_ENABLE
        default DRIVER_ADC4_PAIR_A_MOTOR_NONE
        help
            The motor whose shunt this pair reads. Any overcurrent stops every
            motor; this only names the motor and its overcurrent bit.
        config DRIVER_ADC4_PAIR_A_MOTOR_NONE
            bool "None"
        config DRIVER_ADC4_PAIR_A_MOTOR_AXIS1
            bool "Axis 1 (base)"
        config DRIVER_ADC4_PAIR_A_MOTOR_AXIS2
            bool "Axis 2 (shoulder)"
        config DRIVER_ADC4_PAIR_A_MOTOR_AXIS3
            bool "Axis 3 (elbow)"
        config DRIVER_ADC4_PAIR_A_MOTOR_AXIS4
            bool "Axis 4 (wrist motor 4)"
        config DRIVER_ADC4_PAIR_A_MOTOR_AXIS5
            bool "Axis 5 (wrist motor 5)"
        config DRIVER_ADC4_PAIR_A_MOTOR_GRIPPER
            bool "Gripper"
    endchoice

    config DRIVER_ADC4_PAIR_A_MOTOR_ID
        int
        depends on DRIVER_ADC4_ENABLE
        default 0 if DRIVER_ADC4_PAIR_A_MOTOR_NONE
        default 1 if DRIVER_ADC4_PAIR_A_MOTOR_AXIS1
        default 2 if DRIVER_ADC4_PAIR_A_MOTOR_AXIS2
        default 3 if DRIVER_ADC4_PAIR_A_MOTOR_AXIS3
        default 4 if DRIVER_ADC4_PAIR_A_MOTOR_AXIS4
        default 5 if DRIVER_ADC4_PAIR_A_MOTOR_AXIS5
        default 6 if DRIVER_ADC4_PAIR_A_MOTOR_GRIPPER

    choice DRIVER_ADC4_PAIR_B_MOTOR_SEL
        prompt "ADC 4 A2-A3 measures"
        depends on DRIVER_ADC4_ENABLE
        default DRIVER_ADC4_PAIR_B_MOTOR_NONE
        help
            The motor whose shunt this pair reads. Any overcurrent stops every
            motor; this only names the motor and its overcurrent bit.
        config DRIVER_ADC4_PAIR_B_MOTOR_NONE
            bool "None"
        config DRIVER_ADC4_PAIR_B_MOTOR_AXIS1
            bool "Axis 1 (base)"
        config DRIVER_ADC4_PAIR_B_MOTOR_AXIS2
            bool "Axis 2 (shoulder)"
        config DRIVER_ADC4_PAIR_B_MOTOR_AXIS3
            bool "Axis 3 (elbow)"
        config DRIVER_ADC4_PAIR_B_MOTOR_AXIS4
            bool "Axis 4 (wrist motor 4)"
        config DRIVER_ADC4_PAIR_B_MOTOR_AXIS5
            bool "Axis 5 (wrist motor 5)"
        config DRIVER_ADC4_PAIR_B_MOTOR_GRIPPER
            bool "Gripper"
    endchoice

    config DRIVER_ADC4_PAIR_B_MOTOR_ID
        int
        depends on DRIVER_ADC4_ENABLE
        default 0 if DRIVER_ADC4_PAIR_B_MOTOR_NONE
        default 1 if DRIVER_ADC4_PAIR_B_MOTOR_AXIS1
        default 2 if DRIVER_ADC4_PAIR_B_MOTOR_AXIS2
        default 3 if DRIVER_ADC4_PAIR_B_MOTOR_AXIS3
        default 4 if DRIVER_ADC4_PAIR_B_MOTOR_AXIS4
        default 5 if DRIVER_ADC4_PAIR_B_MOTOR_AXIS5
        default 6 if DRIVER_ADC4_PAIR_B_MOTOR_GRIPPER

    config DRIVER_ADS1015_DATA_RATE
        int "ADS1015 Data Rate"
        range 0 6
        default 6
        help
            Data rate of ADS1015 in samples per second.
            0=128SPS, 1=250SPS, 2=490SPS, 3=920SPS,
            4=1600SPS, 5=2400SPS, 6=3300SPS

    config DRIVER_LIMIT_SWITCH_PIN
        int "Limit Switch Pin"
        default 23
        help
            GPIO pin for limit switch alerts.

    config DRIVER_WIFI_SSID
        string "WiFi SSID"
        default "YourSSID"
        help
            SSID of the WiFi network to connect to.

    config DRIVER_WIFI_PASSWORD
        string "WiFi Password"
        default "YourPassword"
        help
            Password for the WiFi network.

    config DRIVER_SERVER_IP
        string "Server IP Address"
        default "0.0.0.0"
        help
            Listening IP address for the server.

    config DRIVER_SERVER_PORT
        string "Server Port"
        default "8080"
        help
            Listening port for the server.

    choice DRIVER_LINK
        prompt "Command link"
        default DRIVER_LINK_WIFI
        help
            Where motion commands come from.

        config DRIVER_LINK_WIFI
            bool "Commander ICD over Wi-Fi"
        config DRIVER_LINK_PI_SERIAL
            bool "Pi operator (erv) ACL over USB serial"
            help
                The ESP32 stands in for the ER-V controller. The link uses
                UART0 (the USB port), so console output must be set to None
                or moved to UART1.
    endchoice

    config DRIVER_PI_SERIAL_BAUD
        int "Pi serial baud rate"
        depends on DRIVER_LINK_PI_SERIAL
        default 9600
        help
            Must match the Pi's tty. erv never sets the baud; 9600 is the
            ER-V controller's rate and the Linux usb-serial default.

    config DRIVER_PI_SERIAL_DEBUG_REPLY
        bool "Reply with what was parsed (bench only)"
        depends on DRIVER_LINK_PI_SERIAL
        default n
        help
            For testing from a laptop terminal. Leave off with the Pi
            attached: if the Pi's tty echoes, replies come back as commands.

    config DRIVER_MAX_RUN_MS
        int "Longest a pan may run without a new start command (ms)"
        range 0 60000
        default 3000
        help
            An axis driven longer than this since the last polar pan start
            command is stopped. Commander's auto tracking repeats the start
            command every 100 ms; a manual key press sends it once. 0 turns
            the check off.

    config DRIVER_HOMING_ENABLE
        bool "Allow the home command"
        default n
        help
            When off, the home command is rejected and the encoders stay
            zeroed at the boot position. Separate from soft limits so homing
            can run with soft limits on.

            Off by default: a homing run cannot yet be stopped by STOP, a
            client disconnect or the Pi link, and has no timeout; only the
            limit switch or the e-stop ends it.

endmenu

menu "Motors"
    comment "Roles (Axes menu) and ADC pairs pick from these motors"

    menu "Axis 1 (base)"
        config DRIVER_MOTOR_AXIS1_HAT
            int "Motor HAT (1 or 2)"
            range 1 2 if DRIVER_MOTORHAT2_ENABLE
            range 1 1
            default 1
            help
                Which HAT this motor is plugged into. HAT 2 needs Second
                MotorHAT enabled.

        config DRIVER_MOTOR_AXIS1_PORT
            int "Port on that HAT (1-4 = M1-M4)"
            range 1 4
            default 1

        config DRIVER_MOTOR_AXIS1_ENCODER_A_PIN
            int "Encoder channel A (P0) GPIO"
            range 0 39
            default 36

        config DRIVER_MOTOR_AXIS1_ENCODER_B_PIN
            int "Encoder channel B (P1) GPIO"
            range 0 39
            default 39

        config DRIVER_MOTOR_AXIS1_SPEED
            string "Pan speed (fraction of full PWM, 0 to 1)"
            default "0.25"
            help
                Keep a stalled motor inside the TB6612's 1.0 A rating: speed no
                higher than 1.0 A times the motor's winding resistance divided by
                the 12 V supply. 0.25 is safe from about 3 ohms up.

        config DRIVER_MOTOR_AXIS1_ENCODER_SLOTS
            int "Encoder wheel slots"
            range 1 1000
            default 20

        config DRIVER_MOTOR_AXIS1_GEARBOX_RATIO
            string "Motor gearbox ratio (X:1)"
            default "127.1"
            help
                ER-4u manual: motors 1-3 127.1:1, motors 4-5 65.5:1, gripper
                19.5:1.

        config DRIVER_MOTOR_AXIS1_PINION_TEETH
            int "Transmission pinion (motor side) teeth"
            range 1 1000
            default 24
            help
                From the azimuth bring-up.

        config DRIVER_MOTOR_AXIS1_DRIVEN_TEETH
            int "Transmission driven (joint side) teeth"
            range 1 1000
            default 120
            help
                From the azimuth bring-up.

        config DRIVER_MOTOR_AXIS1_RANGE_POS_DEG
            int "Physical travel from home, positive-count direction (deg)"
            range 0 360
            default 133
            help
                Manual: 310 deg total. 133 each way is the azimuth bring-up value.

        config DRIVER_MOTOR_AXIS1_RANGE_NEG_DEG
            int "Physical travel from home, negative-count direction (deg)"
            range 0 360
            default 133
            help
                Manual: 310 deg total. 133 each way is the azimuth bring-up value.

        config DRIVER_MOTOR_AXIS1_FWD_INCREASES
            int "FORWARD increases encoder count (1) or decreases it (0)"
            range 0 1
            default 1
            help
                Bench: FORWARD raised the count.
    endmenu

    menu "Axis 2 (shoulder)"
        config DRIVER_MOTOR_AXIS2_HAT
            int "Motor HAT (1 or 2)"
            range 1 2 if DRIVER_MOTORHAT2_ENABLE
            range 1 1
            default 1
            help
                Which HAT this motor is plugged into. HAT 2 needs Second
                MotorHAT enabled.

        config DRIVER_MOTOR_AXIS2_PORT
            int "Port on that HAT (1-4 = M1-M4)"
            range 1 4
            default 2

        config DRIVER_MOTOR_AXIS2_ENCODER_A_PIN
            int "Encoder channel A (P0) GPIO"
            range 0 39
            default 34

        config DRIVER_MOTOR_AXIS2_ENCODER_B_PIN
            int "Encoder channel B (P1) GPIO"
            range 0 39
            default 35

        config DRIVER_MOTOR_AXIS2_SPEED
            string "Pan speed (fraction of full PWM, 0 to 1)"
            default "0.25"
            help
                Keep a stalled motor inside the TB6612's 1.0 A rating: speed no
                higher than 1.0 A times the motor's winding resistance divided by
                the 12 V supply. 0.25 is safe from about 3 ohms up.

        config DRIVER_MOTOR_AXIS2_ENCODER_SLOTS
            int "Encoder wheel slots"
            range 1 1000
            default 20

        config DRIVER_MOTOR_AXIS2_GEARBOX_RATIO
            string "Motor gearbox ratio (X:1)"
            default "127.1"
            help
                ER-4u manual: motors 1-3 127.1:1, motors 4-5 65.5:1, gripper
                19.5:1.

        config DRIVER_MOTOR_AXIS2_PINION_TEETH
            int "Transmission pinion (motor side) teeth"
            range 1 1000
            default 20
            help
                PLACEHOLDER until bench tested. Old shoulder/elbow default; the real transmission is not counted yet.

        config DRIVER_MOTOR_AXIS2_DRIVEN_TEETH
            int "Transmission driven (joint side) teeth"
            range 1 1000
            default 72
            help
                PLACEHOLDER until bench tested. Old shoulder/elbow default; the real transmission is not counted yet.

        config DRIVER_MOTOR_AXIS2_RANGE_POS_DEG
            int "Physical travel from home, positive-count direction (deg)"
            range 0 360
            default 35
            help
                Manual: +130 / -35 deg. Which side counts positive is not checked
                yet, so both default to the smaller 35.

        config DRIVER_MOTOR_AXIS2_RANGE_NEG_DEG
            int "Physical travel from home, negative-count direction (deg)"
            range 0 360
            default 35
            help
                Manual: +130 / -35 deg. Which side counts positive is not checked
                yet, so both default to the smaller 35.

        config DRIVER_MOTOR_AXIS2_FWD_INCREASES
            int "FORWARD increases encoder count (1) or decreases it (0)"
            range 0 1
            default 1
            help
                PLACEHOLDER until bench tested. The axis 2 encoder did not count in the axis check.
    endmenu

    menu "Axis 3 (elbow)"
        config DRIVER_MOTOR_AXIS3_HAT
            int "Motor HAT (1 or 2)"
            range 1 2 if DRIVER_MOTORHAT2_ENABLE
            range 1 1
            default 1
            help
                Which HAT this motor is plugged into. HAT 2 needs Second
                MotorHAT enabled.

        config DRIVER_MOTOR_AXIS3_PORT
            int "Port on that HAT (1-4 = M1-M4)"
            range 1 4
            default 3

        config DRIVER_MOTOR_AXIS3_ENCODER_A_PIN
            int "Encoder channel A (P0) GPIO"
            range 0 39
            default 32

        config DRIVER_MOTOR_AXIS3_ENCODER_B_PIN
            int "Encoder channel B (P1) GPIO"
            range 0 39
            default 33

        config DRIVER_MOTOR_AXIS3_SPEED
            string "Pan speed (fraction of full PWM, 0 to 1)"
            default "0.25"
            help
                Keep a stalled motor inside the TB6612's 1.0 A rating: speed no
                higher than 1.0 A times the motor's winding resistance divided by
                the 12 V supply. 0.25 is safe from about 3 ohms up.

        config DRIVER_MOTOR_AXIS3_ENCODER_SLOTS
            int "Encoder wheel slots"
            range 1 1000
            default 20

        config DRIVER_MOTOR_AXIS3_GEARBOX_RATIO
            string "Motor gearbox ratio (X:1)"
            default "127.1"
            help
                ER-4u manual: motors 1-3 127.1:1, motors 4-5 65.5:1, gripper
                19.5:1.

        config DRIVER_MOTOR_AXIS3_PINION_TEETH
            int "Transmission pinion (motor side) teeth"
            range 1 1000
            default 20
            help
                PLACEHOLDER until bench tested. Old shoulder/elbow default; the real transmission is not counted yet.

        config DRIVER_MOTOR_AXIS3_DRIVEN_TEETH
            int "Transmission driven (joint side) teeth"
            range 1 1000
            default 72
            help
                PLACEHOLDER until bench tested. Old shoulder/elbow default; the real transmission is not counted yet.

        config DRIVER_MOTOR_AXIS3_RANGE_POS_DEG
            int "Physical travel from home, positive-count direction (deg)"
            range 0 360
            default 130
            help
                Manual: +-130 deg.

        config DRIVER_MOTOR_AXIS3_RANGE_NEG_DEG
            int "Physical travel from home, negative-count direction (deg)"
            range 0 360
            default 130
            help
                Manual: +-130 deg.

        config DRIVER_MOTOR_AXIS3_FWD_INCREASES
            int "FORWARD increases encoder count (1) or decreases it (0)"
            range 0 1
            default 1
            help
                PLACEHOLDER until bench tested.
    endmenu

    menu "Axis 4 (wrist motor 4)"
        config DRIVER_MOTOR_AXIS4_HAT
            int "Motor HAT (1 or 2)"
            range 1 2 if DRIVER_MOTORHAT2_ENABLE
            range 1 1
            default 1
            help
                Which HAT this motor is plugged into. HAT 2 needs Second
                MotorHAT enabled.

        config DRIVER_MOTOR_AXIS4_PORT
            int "Port on that HAT (1-4 = M1-M4)"
            range 1 4
            default 4

        config DRIVER_MOTOR_AXIS4_ENCODER_A_PIN
            int "Encoder channel A (P0) GPIO"
            range 0 39
            default 25

        config DRIVER_MOTOR_AXIS4_ENCODER_B_PIN
            int "Encoder channel B (P1) GPIO"
            range 0 39
            default 26

        config DRIVER_MOTOR_AXIS4_SPEED
            string "Pan speed (fraction of full PWM, 0 to 1)"
            default "0.5"
            help
                Keep a stalled motor inside the TB6612's 1.0 A rating: speed no
                higher than 1.0 A times the motor's winding resistance divided by
                the 12 V supply. Bluey's wrist motors measure 9 ohms, so up to
                0.75 is safe; at 0.25 they stall against the wrist.

        config DRIVER_MOTOR_AXIS4_ENCODER_SLOTS
            int "Encoder wheel slots"
            range 1 1000
            default 20

        config DRIVER_MOTOR_AXIS4_GEARBOX_RATIO
            string "Motor gearbox ratio (X:1)"
            default "65.5"
            help
                ER-4u manual: motors 1-3 127.1:1, motors 4-5 65.5:1, gripper
                19.5:1.

        config DRIVER_MOTOR_AXIS4_PINION_TEETH
            int "Transmission pinion (motor side) teeth"
            range 1 1000
            default 12
            help
                ER-4pc wrist values from the altitude bring-up.

        config DRIVER_MOTOR_AXIS4_DRIVEN_TEETH
            int "Transmission driven (joint side) teeth"
            range 1 1000
            default 23
            help
                ER-4pc wrist values from the altitude bring-up.

        config DRIVER_MOTOR_AXIS4_RANGE_POS_DEG
            int "Physical travel from home, positive-count direction (deg)"
            range 0 360
            default 45
            help
                Wrist bring-up value. Manual: wrist pitch +-130 deg (motors 4 and 5 together).

        config DRIVER_MOTOR_AXIS4_RANGE_NEG_DEG
            int "Physical travel from home, negative-count direction (deg)"
            range 0 360
            default 45
            help
                Wrist bring-up value. Manual: wrist pitch +-130 deg (motors 4 and 5 together).

        config DRIVER_MOTOR_AXIS4_FWD_INCREASES
            int "FORWARD increases encoder count (1) or decreases it (0)"
            range 0 1
            default 0
            help
                Bench: FORWARD lowered the count.
    endmenu

    menu "Axis 5 (wrist motor 5)"
        config DRIVER_MOTOR_AXIS5_HAT
            int "Motor HAT (1 or 2)"
            range 1 2 if DRIVER_MOTORHAT2_ENABLE
            range 1 1
            default 2
            help
                Which HAT this motor is plugged into. HAT 2 needs Second
                MotorHAT enabled.

        config DRIVER_MOTOR_AXIS5_PORT
            int "Port on that HAT (1-4 = M1-M4)"
            range 1 4
            default 3

        config DRIVER_MOTOR_AXIS5_ENCODER_A_PIN
            int "Encoder channel A (P0) GPIO"
            range 0 39
            default 27

        config DRIVER_MOTOR_AXIS5_ENCODER_B_PIN
            int "Encoder channel B (P1) GPIO"
            range 0 39
            default 14

        config DRIVER_MOTOR_AXIS5_SPEED
            string "Pan speed (fraction of full PWM, 0 to 1)"
            default "0.5"
            help
                Keep a stalled motor inside the TB6612's 1.0 A rating: speed no
                higher than 1.0 A times the motor's winding resistance divided by
                the 12 V supply. Bluey's wrist motors measure 9 ohms, so up to
                0.75 is safe; at 0.25 they stall against the wrist.

        config DRIVER_MOTOR_AXIS5_ENCODER_SLOTS
            int "Encoder wheel slots"
            range 1 1000
            default 20

        config DRIVER_MOTOR_AXIS5_GEARBOX_RATIO
            string "Motor gearbox ratio (X:1)"
            default "65.5"
            help
                ER-4u manual: motors 1-3 127.1:1, motors 4-5 65.5:1, gripper
                19.5:1.

        config DRIVER_MOTOR_AXIS5_PINION_TEETH
            int "Transmission pinion (motor side) teeth"
            range 1 1000
            default 12
            help
                ER-4pc wrist values from the altitude bring-up.

        config DRIVER_MOTOR_AXIS5_DRIVEN_TEETH
            int "Transmission driven (joint side) teeth"
            range 1 1000
            default 23
            help
                ER-4pc wrist values from the altitude bring-up.

        config DRIVER_MOTOR_AXIS5_RANGE_POS_DEG
            int "Physical travel from home, positive-count direction (deg)"
            range 0 360
            default 45
            help
                Wrist bring-up value. Manual: wrist roll is unlimited mechanically.

        config DRIVER_MOTOR_AXIS5_RANGE_NEG_DEG
            int "Physical travel from home, negative-count direction (deg)"
            range 0 360
            default 45
            help
                Wrist bring-up value. Manual: wrist roll is unlimited mechanically.

        config DRIVER_MOTOR_AXIS5_FWD_INCREASES
            int "FORWARD increases encoder count (1) or decreases it (0)"
            range 0 1
            default 1
            help
                Bench: FORWARD raised the count.
    endmenu

    menu "Gripper"
        config DRIVER_MOTOR_GRIPPER_HAT
            int "Motor HAT (1 or 2)"
            range 1 2 if DRIVER_MOTORHAT2_ENABLE
            range 1 1
            default 2
            help
                Which HAT this motor is plugged into. HAT 2 needs Second
                MotorHAT enabled.

        config DRIVER_MOTOR_GRIPPER_PORT
            int "Port on that HAT (1-4 = M1-M4)"
            range 1 4
            default 4

        config DRIVER_MOTOR_GRIPPER_ENCODER_A_PIN
            int "Encoder channel A (P0) GPIO"
            range 0 39
            default 13

        config DRIVER_MOTOR_GRIPPER_ENCODER_B_PIN
            int "Encoder channel B (P1) GPIO"
            range 0 39
            default 4

        config DRIVER_MOTOR_GRIPPER_SPEED
            string "Pan speed (fraction of full PWM, 0 to 1)"
            default "0.25"
            help
                Keep a stalled motor inside the TB6612's 1.0 A rating: speed no
                higher than 1.0 A times the motor's winding resistance divided by
                the 12 V supply. 0.25 is safe from about 3 ohms up.

        config DRIVER_MOTOR_GRIPPER_ENCODER_SLOTS
            int "Encoder wheel slots"
            range 1 1000
            default 20

        config DRIVER_MOTOR_GRIPPER_GEARBOX_RATIO
            string "Motor gearbox ratio (X:1)"
            default "19.5"
            help
                ER-4u manual: motors 1-3 127.1:1, motors 4-5 65.5:1, gripper
                19.5:1.

        config DRIVER_MOTOR_GRIPPER_PINION_TEETH
            int "Transmission pinion (motor side) teeth"
            range 1 1000
            default 1
            help
                PLACEHOLDER until bench tested. 1:1 means no transmission after the gearbox.

        config DRIVER_MOTOR_GRIPPER_DRIVEN_TEETH
            int "Transmission driven (joint side) teeth"
            range 1 1000
            default 1
            help
                PLACEHOLDER until bench tested. 1:1 means no transmission after the gearbox.

        config DRIVER_MOTOR_GRIPPER_RANGE_POS_DEG
            int "Physical travel from home, positive-count direction (deg)"
            range 0 360
            default 45
            help
                PLACEHOLDER until bench tested. Degrees here are motor output degrees, not finger travel.

        config DRIVER_MOTOR_GRIPPER_RANGE_NEG_DEG
            int "Physical travel from home, negative-count direction (deg)"
            range 0 360
            default 45
            help
                PLACEHOLDER until bench tested. Degrees here are motor output degrees, not finger travel.

        config DRIVER_MOTOR_GRIPPER_FWD_INCREASES
            int "FORWARD increases encoder count (1) or decreases it (0)"
            range 0 1
            default 1
            help
                PLACEHOLDER until bench tested. The gripper encoder did not count in the axis check.
    endmenu

endmenu

menu "Axes"
    comment "Which motor plays each role. Motor values are in the Motors menu."

    choice DRIVER_AZIMUTH_MOTOR_SEL
        prompt "Azimuth (pan) motor"
        default DRIVER_AZIMUTH_MOTOR_AXIS1
        config DRIVER_AZIMUTH_MOTOR_AXIS1
            bool "Axis 1 (base)"
        config DRIVER_AZIMUTH_MOTOR_AXIS2
            bool "Axis 2 (shoulder)"
        config DRIVER_AZIMUTH_MOTOR_AXIS3
            bool "Axis 3 (elbow)"
        config DRIVER_AZIMUTH_MOTOR_AXIS4
            bool "Axis 4 (wrist motor 4)"
        config DRIVER_AZIMUTH_MOTOR_AXIS5
            bool "Axis 5 (wrist motor 5)"
        config DRIVER_AZIMUTH_MOTOR_GRIPPER
            bool "Gripper"
    endchoice

    config DRIVER_AZIMUTH_MOTOR_ID
        int
        default 1 if DRIVER_AZIMUTH_MOTOR_AXIS1
        default 2 if DRIVER_AZIMUTH_MOTOR_AXIS2
        default 3 if DRIVER_AZIMUTH_MOTOR_AXIS3
        default 4 if DRIVER_AZIMUTH_MOTOR_AXIS4
        default 5 if DRIVER_AZIMUTH_MOTOR_AXIS5
        default 6 if DRIVER_AZIMUTH_MOTOR_GRIPPER

    choice DRIVER_ALTITUDE_MOTOR_SEL
        prompt "Altitude (tilt) motor"
        default DRIVER_ALTITUDE_MOTOR_AXIS4
        config DRIVER_ALTITUDE_MOTOR_AXIS1
            bool "Axis 1 (base)"
        config DRIVER_ALTITUDE_MOTOR_AXIS2
            bool "Axis 2 (shoulder)"
        config DRIVER_ALTITUDE_MOTOR_AXIS3
            bool "Axis 3 (elbow)"
        config DRIVER_ALTITUDE_MOTOR_AXIS4
            bool "Axis 4 (wrist motor 4)"
        config DRIVER_ALTITUDE_MOTOR_AXIS5
            bool "Axis 5 (wrist motor 5)"
        config DRIVER_ALTITUDE_MOTOR_GRIPPER
            bool "Gripper"
    endchoice

    config DRIVER_ALTITUDE_MOTOR_ID
        int
        default 1 if DRIVER_ALTITUDE_MOTOR_AXIS1
        default 2 if DRIVER_ALTITUDE_MOTOR_AXIS2
        default 3 if DRIVER_ALTITUDE_MOTOR_AXIS3
        default 4 if DRIVER_ALTITUDE_MOTOR_AXIS4
        default 5 if DRIVER_ALTITUDE_MOTOR_AXIS5
        default 6 if DRIVER_ALTITUDE_MOTOR_GRIPPER

    config DRIVER_ALTITUDE_B_ENABLE
        bool "Drive altitude with a second motor (ER-4pc wrist pitch)"
        default y
        help
            The ER-4pc wrist is a bevel gear differential: driving both wrist
            motors together pitches it, and one motor alone pitches and rolls
            it at once. When enabled, altitude commands drive both wrist
            motors at the altitude motor's speed, and if either one stops the
            other stops too.

    choice DRIVER_ALTITUDE_B_MOTOR_SEL
        prompt "Second altitude motor"
        depends on DRIVER_ALTITUDE_B_ENABLE
        default DRIVER_ALTITUDE_B_MOTOR_AXIS5
        config DRIVER_ALTITUDE_B_MOTOR_AXIS1
            bool "Axis 1 (base)"
        config DRIVER_ALTITUDE_B_MOTOR_AXIS2
            bool "Axis 2 (shoulder)"
        config DRIVER_ALTITUDE_B_MOTOR_AXIS3
            bool "Axis 3 (elbow)"
        config DRIVER_ALTITUDE_B_MOTOR_AXIS4
            bool "Axis 4 (wrist motor 4)"
        config DRIVER_ALTITUDE_B_MOTOR_AXIS5
            bool "Axis 5 (wrist motor 5)"
        config DRIVER_ALTITUDE_B_MOTOR_GRIPPER
            bool "Gripper"
    endchoice

    config DRIVER_ALTITUDE_B_MOTOR_ID
        int
        depends on DRIVER_ALTITUDE_B_ENABLE
        default 1 if DRIVER_ALTITUDE_B_MOTOR_AXIS1
        default 2 if DRIVER_ALTITUDE_B_MOTOR_AXIS2
        default 3 if DRIVER_ALTITUDE_B_MOTOR_AXIS3
        default 4 if DRIVER_ALTITUDE_B_MOTOR_AXIS4
        default 5 if DRIVER_ALTITUDE_B_MOTOR_AXIS5
        default 6 if DRIVER_ALTITUDE_B_MOTOR_GRIPPER

    config DRIVER_ALTITUDE_B_REVERSED
        bool "Drive the second altitude motor opposite to the first"
        depends on DRIVER_ALTITUDE_B_ENABLE
        default n
        help
            Off for Bluey: with its wiring, both wrist motors driven the same
            direction pitch the wrist, and opposite directions roll it
            (bench test, Nov 13 2026). If a tilt command rolls the wrist
            instead, the motors are wired the other way around: change this.

endmenu

menu "Soft Limits"
    config DRIVER_SOFT_LIMITS_ENABLE
        bool "Enable encoder soft limits"
        default y
        help
            Stops an axis once its encoder count passes a bound computed from
            the values below. Count 0 is the boot position until a home
            command re-zeroes it at the limit switch.

    config DRIVER_SOFT_LIMITS_PERCENT
        int "Percent of physical travel allowed on each side of home"
        range 1 100
        default 50

    config DRIVER_SOFT_LIMITS_POLL_MS
        int "Soft limit check interval (ms)"
        range 1 100
        default 10

        comment "Gearing and travel for each motor are in the Motors menu"
endmenu